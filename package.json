{
  "name": "zhiheng-personal-agent",
  "version": "0.10.1",
  "private": true,
  "scripts": {
    "dev": "node scripts/launch.mjs dev",
    "build": "next build",
    "start": "node scripts/launch.mjs start",
    "worker": "tsx --env-file-if-exists=.env.local server/worker.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "backup": "tsx scripts/backup.ts",
    "harness:check": "node runtime/dsh/adapter-smoke.mjs && node --test runtime/dsh/*.test.mjs",
    "test:ui": "node scripts/functional-smoke.mjs",
    "memory:setup": "node scripts/setup-memory.mjs",
    "radar:check": "tsx scripts/check-observation.ts",
    "records:check": "tsx scripts/library/check-live.ts",
    "radar:themes": "tsx scripts/check-theme-radar.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@larksuiteoapi/node-sdk": "^1.76.0",
    "@mozilla/readability": "^0.6.0",
    "ipaddr.js": "^2.5.0",
    "linkedom": "^0.18.15",
    "next": "16.4.5",
    "pdfjs-dist": "^6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsx": "4.23.15",
    "typescript": "^5.9"
  },
  "engines": {
    "node": ">=24.9.0"
  },
  "type": "module"
}
